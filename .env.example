# Vorlage – als ".env" speichern und anpassen

# Port der Weboberfläche
PORT=3080
# Zeitzone für Uhrzeiten in Benachrichtigungen
TZ=Europe/Berlin
# Sprache beim ersten Start (de oder en); später in der Oberfläche änderbar
PRINTDOCK_LANG=de

# Tailscale (Profil "tailscale"): Auth-Key aus https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=printdock

# Cloudflare Tunnel (Profil "cloudflare"): Token aus Zero Trust → Networks → Tunnels
CF_TUNNEL_TOKEN=
