{
  "name": "printdock",
  "version": "0.24.1",
  "description": "Manage and monitor 3D printers from any vendor (Bambu Lab, Klipper/Moonraker, OctoPrint, …) – queue, orders, filament, maintenance, Home Assistant",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "ha-addon": "node scripts/build-ha-addon.js",
    "check": "node scripts/check.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "basic-ftp": "^6.2.2",
    "busboy": "^1.6.0",
    "mqtt": "^5.16.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Codegulasch/printdock.git"
  },
  "homepage": "https://github.com/Codegulasch/printdock",
  "keywords": [
    "3d-printing",
    "bambu-lab",
    "klipper",
    "moonraker",
    "octoprint",
    "print-farm",
    "home-assistant",
    "filament"
  ]
}
